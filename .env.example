APP_NAME=FiberApp
APP_PORT=:3000
APP_ENV=development
APP_DEBUG=true
APP_VERSION=1.0.0

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=secret
DB_NAME=fiber_db
DB_SSLMODE=disable
DB_ENABLE=false
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m

LOGGER_PATH=logs/app.log
LOG_MAX_SIZE=100
LOG_MAX_BACKUPS=3
LOG_MAX_AGE=28
LOG_COMPRESS=true
LOG_LEVEL=debug
